# Copy to `.env`. Docker Compose reads the model settings from it; the API and worker also read it when run on the
# host. Nothing here is a secret except a hosted provider's key, which belongs only in your own `.env`.

# --- Model: LM Studio on this machine (the defaults) ---
# Load both models first, with no idle timer:
#   lms load google/gemma-4-26b-a4b-qat -c 16384 -y
#   lms load text-embedding-nomic-embed-text-v1.5 -y
# Leave MODEL_BASE_URL unset for LM Studio: Compose then uses http://host.docker.internal:1234/v1 and a host run
# uses http://127.0.0.1:1234/v1. (127.0.0.1 inside a container would mean the container itself.)
CHAT_MODEL=google/gemma-4-26b-a4b-qat
# Gemma's recommended sampling (from LM Studio's model.yaml for it).
CHAT_TEMPERATURE=1.0
CHAT_TOP_P=0.95
CHAT_TOP_K=64
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "
# The retry with thinking off after a runaway or an unusable reply: Gemma's switch is "none".
CHAT_RETRY_REASONING_EFFORT=none
# The worker makes one tiny call to each model at start and reports the result on /ready. LM Studio loads a model
# on demand when asked for one, so a worker restart can load it; set false if that is unwanted.
MODEL_STARTUP_CHECK=true

# --- Model: Google Gemini instead (any OpenAI-compatible service works the same way) ---
# The free tier often answers 503 or 429 and may use what you send to improve Google's products.
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_API_KEY=your-key
# CHAT_MODEL=gemini-3.5-flash
# CHAT_TEMPERATURE=
# CHAT_TOP_P=
# CHAT_TOP_K=
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DOC_PREFIX="title: none | text: "
# EMBEDDING_QUERY_PREFIX="task: search result | query: "
# CHAT_RETRY_REASONING_EFFORT=low

# Answer limits: thinking tokens plus room for the JSON answer, and the passage budget per question.
CHAT_MAX_TOKENS=1700
PASSAGE_TOKEN_BUDGET=4000

# --- Running the API or worker on the host (not needed for Compose) ---
#   docker compose -f compose.yaml -f compose.dev.yaml up -d postgres redis
#   npm run dev:api -w server     and, in a second terminal,     npm run dev:worker -w server
# and, for PDFs, in a third:      npm run dev:parser -w server    (on PDF_PARSER_PORT, 3100, where the worker's
# PDF_PARSER_URL looks)
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://curie:curie-local@127.0.0.1:55432/curie
REDIS_URL=redis://127.0.0.1:56379

# Tests on the host instead of `docker compose run --rm test` need the test database (its name must end in _test)
# and Redis database 1:
#   DATABASE_URL=postgres://curie:curie-local@127.0.0.1:55432/curie_test REDIS_URL=redis://127.0.0.1:56379/1 npm test

# Compose reads this one; it ends up raw inside connection URLs, so use URL-safe characters only.
# POSTGRES_PASSWORD=curie-local
